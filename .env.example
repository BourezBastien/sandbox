# Base de données Postgres (Dokploy en production)
DATABASE_URL=

# Better Auth : secret de 32+ caractères (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL publique de l'application
BETTER_AUTH_URL=
# Optionnel : origines de confiance séparées par des virgules
# BETTER_AUTH_TRUSTED_ORIGINS=

# IA z.ai (endpoint Anthropic-compatible par défaut)
Z_AI_API_KEY=
# Z_AI_BASE_URL=https://api.z.ai/api/anthropic/v1

# IA DeepSeek (endpoint Anthropic-compatible ; modèle par défaut de l'app)
# Clé : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1

# Trigger.dev : TRIGGER_SECRET_KEY sert à l'app (déclencher les tours) ;
# TRIGGER_ACCESS_TOKEN (cloud.trigger.dev/account/tokens) + TRIGGER_PROJECT_REF
# servent au déploiement du worker (conteneur au démarrage, ou npm run trigger:deploy)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_ACCESS_TOKEN=

# Daytona
DAYTONA_API_KEY=

# Sentry (optionnel)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
