# Base de données Postgres (Dokploy en production)
DATABASE_URL=

# Better Auth — secret de 32+ caractères : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'application
BETTER_AUTH_URL=
# Optionnel — origines de confiance séparées par des virgules
# BETTER_AUTH_TRUSTED_ORIGINS=

# IA z.ai (endpoint Anthropic-compatible par défaut)
Z_AI_API_KEY=
# Z_AI_BASE_URL=https://api.z.ai/api/anthropic

# Trigger.dev (localement pour trigger dev ; en production Dokploy : le
# conteneur déploie le worker au démarrage avec ces variables)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Daytona
DAYTONA_API_KEY=

# Sentry (optionnel)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
